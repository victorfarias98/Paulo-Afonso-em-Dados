# Faixa Baius para frontends locais: 3100-3199.
BAIUS_PAD_PORT=3104

# Banco de dados (valores de desenvolvimento local; troque em produção)
POSTGRES_USER=pad
POSTGRES_PASSWORD=pad_dev_password
POSTGRES_DB=paulo_afonso_em_dados
POSTGRES_PORT=5433
DATABASE_URL=postgres://pad:pad_dev_password@localhost:5433/paulo_afonso_em_dados

# Identificação do coletor perante as fontes oficiais
COLLECTOR_USER_AGENT="PauloAfonsoEmDados/0.1 (+contato@baiustecnologia.com.br)"
# Intervalo mínimo entre requisições ao mesmo host, em milissegundos
COLLECTOR_MIN_INTERVAL_MS=2500

# Banco usado só pelos testes de integração (é esvaziado a cada teste)
TEST_DATABASE_URL=postgres://pad:pad_dev_password@localhost:5433/pad_test

# Horário da coleta diária, na hora de Paulo Afonso (usado pelo worker em produção)
WORKER_DAILY_AT=05:00

# Área administrativa (/admin). Sem as duas variáveis, ou com senha de menos de 12 caracteres, fica desligada.
ADMIN_USER=
ADMIN_PASSWORD=

# Apenas web. PostHog no runtime; token público do projeto, nunca chave pessoal.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false
