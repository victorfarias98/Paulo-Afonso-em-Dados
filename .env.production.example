# Coolify: variáveis de RUNTIME, nunca build args.
# Use a URL INTERNA fornecida pelo recurso PostgreSQL do Coolify.
# Escape caracteres especiais de usuário/senha na URL (percent-encoding).
DATABASE_URL=postgresql://USUARIO:SENHA_CODIFICADA@HOST_INTERNO:5432/paulo_afonso_em_dados

# Apenas web. Porta interna padrão dos frontends Baius.
PORT=8080
HOSTNAME=0.0.0.0
# Opcional. Ambas vazias mantêm /admin desligado.
ADMIN_USER=
ADMIN_PASSWORD=

# Apenas worker. Hora de Paulo Afonso (America/Bahia).
COLLECTOR_USER_AGENT="PauloAfonsoEmDados/0.1 (+contato@baiustecnologia.com.br)"
COLLECTOR_MIN_INTERVAL_MS=2500
WORKER_DAILY_AT=05:00

# Apenas web. PostHog no runtime; token público do projeto, nunca chave pessoal.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true
